# Database URL: sqlite:///./campaign_amplifier.db for local development
# or postgresql://postgres:password@localhost:5432/campaign_amplifier for production / Supabase
DATABASE_URL=sqlite:///./campaign_amplifier.db

# JWT secret key for access token signing
JWT_SECRET=super-secret-key-change-in-production-hackathon-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Optional Gemini API key for real AI campaign structuring (falls back to deterministic demo mode if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Uploads directory
UPLOADS_DIR=./uploads

# Environment: development / production
ENVIRONMENT=development
CORS_ORIGINS="*"
